# Image Prep — environment template. Copy to `.env` and fill in.
# `.env` is gitignored. NEVER commit real secrets.

# =====================================================================
# Auth — this app is internet-facing on its own domain, so this login IS
# the security boundary. Tailscale only covers the VPS -> MinIO hop.
# =====================================================================

# Signs session cookies. The app REFUSES TO START if this is empty.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

APP_USERNAME=admin

# bcrypt hash, not the password itself — a plaintext password in .env is
# readable by anything that can read the file.
#   docker compose run --rm scanner python -c \
#     "from app.api.auth import hash_password; print(hash_password('YOUR-PASSWORD'))"
APP_PASSWORD_HASH=

# 1 when served over HTTPS (the normal case behind Caddy/nginx).
# Only set 0 for plain-HTTP local testing.
COOKIE_SECURE=1

# =====================================================================
# Public image serving — the Gemini stage fetches these URLs anonymously
# =====================================================================

# Public origin, no trailing slash. Baked into every minted image URL, so
# changing it later invalidates URLs already published to MinIO.
PUBLIC_BASE_URL=https://your-domain.example.com

# Separate from AUTH_SECRET so rotating one does not invalidate the other.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
IMAGE_SIGNING_SECRET=

# A Gemini batch is not instantaneous. A TTL shorter than the downstream run
# is a silent failure at the last step of the pipeline.
IMAGE_URL_TTL_DAYS=30

# =====================================================================
# MinIO — OPTIONAL. Leave commented out for the normal flow.
# =====================================================================
#
# The default flow needs NO MinIO at all:
#
#   1. Upload valid_post.jsonl from the dashboard
#   2. Prepare (a local checkpoint means re-uploading the cumulative export
#      only processes posts that are actually new)
#   3. Download ready_for_ocr.jsonl and hand it to the Gemini stage
#
# The app starts and runs perfectly well with everything below unset — it
# simply hides the MinIO parts of the UI. Uncomment ONLY if you want it to
# read the crawler's by_run logs directly and mirror results back.
#
# Both MINIO_ENDPOINT and MINIO_GROUP_PREFIX must be set for that to switch
# on; setting one without the other keeps MinIO disabled.
#
# The endpoint MUST be reachable from THIS host. A *.svc.cluster.local
# address will NOT resolve from outside the k3s cluster — you need the
# tailnet-reachable NodePort or ingress, e.g. http://100.x.y.z:31234
# (a NodePort is in the 30000-32767 range, not 9000).
#
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_SECURE=false
# MINIO_BUCKET=final-exam-nlp-raw
# MINIO_GROUP_PREFIX=facebook/322453387859386
#
# Output namespace, written beside the crawler's export/ logs/ state/:
#   <group>/han_scan/export/ready_for_ocr.jsonl    -> feeds the Gemini stage
#   <group>/han_scan/errors/failed.jsonl           cumulative failures
#   <group>/han_scan/logs/by_run/<run>/…           per-run result/upserts/errors
#   <group>/han_scan/state/processed_ids.jsonl     idempotency index
# MINIO_OUTPUT_PREFIX=han_scan

# The crawler's exports contain BOTH valid and invalid posts.
# 1 = prepare only is_valid==true (default). 0 = everything with image_urls.
ONLY_CRAWLER_VALID=1

# =====================================================================
# Batch + scheduler
# =====================================================================

# Posts per batch. Small batches keep failures cheap, progress visible, and
# images fetched while their signed URLs are still fresh.
BATCH_SIZE=500

# Seconds between scheduler wake-ups. Only relevant when MinIO is configured —
# the upload flow is user-driven, so the scheduler stays idle without it.
SCAN_INTERVAL=300
SCHEDULER_ENABLED=1

DATA_DIR=/data

# =====================================================================
# Downloads (Facebook CDN)
# =====================================================================

DOWNLOAD_CONCURRENCY=16
DOWNLOAD_TIMEOUT=30
DOWNLOAD_MAX_ATTEMPTS=4

# Floor the adaptive throttle backs off to when the CDN returns sustained 429s.
DOWNLOAD_MIN_CONCURRENCY=2

# Per-image size cap in bytes (25 MB). Guards the disk against absurd payloads.
DOWNLOAD_MAX_BYTES=26214400
