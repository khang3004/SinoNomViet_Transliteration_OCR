# Han Scanner — environment template. Copy to `.env` and fill in.
# `.env` is gitignored. NEVER commit real secrets.

# =====================================================================
# Auth — this app is internet-facing on its own domain, so this login IS
# the security boundary. Tailscale only covers the VPS -> MinIO hop.
# =====================================================================

# Signs session cookies. The app REFUSES TO START if this is empty.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

APP_USERNAME=admin

# bcrypt hash, not the password itself — a plaintext password in .env is
# readable by anything that can read the file.
#   docker compose run --rm scanner python -c \
#     "from app.api.auth import hash_password; print(hash_password('YOUR-PASSWORD'))"
APP_PASSWORD_HASH=

# 1 when served over HTTPS (the normal case behind Caddy/nginx).
# Only set 0 for plain-HTTP local testing.
COOKIE_SECURE=1

# =====================================================================
# Public image serving — the Gemini stage fetches these URLs anonymously
# =====================================================================

# Public origin, no trailing slash. Baked into every minted image URL, so
# changing it later invalidates URLs already published to MinIO.
PUBLIC_BASE_URL=https://scanner.example.com

# Separate from AUTH_SECRET so rotating one does not invalidate the other.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
IMAGE_SIGNING_SECRET=

# A Gemini batch is not instantaneous. A TTL shorter than the downstream run
# is a silent failure at the last step of the pipeline.
IMAGE_URL_TTL_DAYS=30

# =====================================================================
# MinIO (k3s cluster, reached over Tailscale)
# =====================================================================

# MUST be reachable from THIS host. A *.svc.cluster.local address will NOT
# resolve from outside the cluster — use the tailnet NodePort/ingress, e.g.
#   http://100.x.y.z:9000
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false

MINIO_BUCKET=final-exam-nlp-raw
MINIO_GROUP_PREFIX=facebook/322453387859386

# Our output namespace, written as a sibling of the crawler's export/ logs/ state/:
#   <group>/han_scan/export/han_valid.jsonl        has Han text -> feeds Gemini
#   <group>/han_scan/export/han_invalid.jsonl      scanned clean
#   <group>/han_scan/errors/failed.jsonl           cumulative failures
#   <group>/han_scan/logs/by_run/<run>/…           per-run result/upserts/errors
#   <group>/han_scan/state/processed_ids.jsonl     idempotency index
MINIO_OUTPUT_PREFIX=han_scan

# by_run/*/upserts.jsonl contains BOTH crawler-valid and crawler-invalid posts.
# 1 = scan only is_valid==true (default). 0 = scan everything with image_urls.
ONLY_CRAWLER_VALID=1

# =====================================================================
# Batch + scheduler
# =====================================================================

# Posts per batch. Small batches keep failures cheap, progress visible, and
# images fetched while their signed URLs are still fresh.
BATCH_SIZE=500

# Seconds between scheduler wake-ups.
SCAN_INTERVAL=300
SCHEDULER_ENABLED=1

DATA_DIR=/data

# =====================================================================
# OCR — PP-OCRv6 via paddleocr 3.7.x
# =====================================================================

# 4 vCPU minus one for the API and download loop. Confirm with a limit=100
# benchmark before the full run: RAM, not CPU, is what kills a long batch.
OCR_WORKERS=3

# PP-OCRv6 is a single unified multilingual model; 'ch' covers Han.
OCR_LANG=ch
OCR_MIN_CONFIDENCE=0.3

# Recorded on every output record so downstream can tell which engine produced
# a verdict. Auto-detected from the installed package; override only if pinning.
OCR_ENGINE_NAME=paddleocr-3.7.0:PP-OCRv6

# Total RSS across OCR workers, in MB. The pool sheds a worker rather than
# waiting for the OOM killer. Leave headroom below the container limit.
MEMORY_LIMIT_MB=6144

# Per-image ceiling so one pathological file cannot stall a worker.
OCR_TIMEOUT=120

# =====================================================================
# Downloads (Facebook CDN)
# =====================================================================

DOWNLOAD_CONCURRENCY=16
DOWNLOAD_TIMEOUT=30
DOWNLOAD_MAX_ATTEMPTS=4

# Floor the adaptive throttle backs off to when the CDN returns sustained 429s.
DOWNLOAD_MIN_CONCURRENCY=2

# Per-image size cap in bytes (25 MB). Guards the disk against absurd payloads.
DOWNLOAD_MAX_BYTES=26214400
