# OCR Review — environment template. Copy to `.env` and fill in.
# `.env` is gitignored. NEVER commit real secrets.

# =====================================================================
# Auth — this app is internet-facing on its own domain, so this login IS
# the security boundary.
# =====================================================================

# Signs session cookies. The app REFUSES TO START if this is empty.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# The super admin. It lives here rather than in data/users.json so a mistake
# in the user file can never lock everyone out. It cannot be renamed,
# recreated or disabled through the UI.
APP_USERNAME=admin

# bcrypt hash, not the password itself — a plaintext password in .env is
# readable by anything that can read the file.
#   docker compose run --rm review python -m app.cli --hash-password
APP_PASSWORD_HASH=

# 1 when served over HTTPS (the normal case behind Caddy/nginx).
# Only set 0 for plain-HTTP local testing.
COOKIE_SECURE=1

# =====================================================================
# Google Drive — where the upstream team's images live
# =====================================================================

# The shared folder. A full URL works too; only the id is kept.
GOOGLE_DRIVE_FOLDER_ID=https://drive.google.com/drive/folders/1sdtPaCUhEV225RJkXTQiF-5Ww48pxTsh

# A public folder can be READ anonymously but not LISTED anonymously, so a
# key is required to map filenames to file ids. Create a free one at
# console.cloud.google.com -> APIs & Services -> Credentials -> API key,
# then enable "Google Drive API" for that project. Restrict the key to the
# Drive API. It grants nothing beyond reading what is already public.
GOOGLE_DRIVE_API_KEY=

DRIVE_TIMEOUT=60
DRIVE_MAX_BYTES=26214400

# =====================================================================
# Image serving — reviewers load images from us, not from Drive
# =====================================================================

# Public origin, no trailing slash.
PUBLIC_BASE_URL=https://your-domain.example.com

# Separate from AUTH_SECRET so rotating one does not invalidate the other.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
IMAGE_SIGNING_SECRET=

# Image URLs are re-minted every time the page loads, so this only has to
# outlive a single review session.
IMAGE_URL_TTL_DAYS=7

# =====================================================================
# Sampling — how the review sample is drawn
# =====================================================================

# Images handed out per "Get images" click.
SAMPLE_BATCH=100
SAMPLE_MAX_BATCH=1000

# No post contributes more than this many images to the whole audit, so one
# prolific page cannot dominate the sample. 0 disables the cap.
SAMPLE_PER_POST_CAP=2

# Share of every sample per band, where the band is how far the upstream
# Gemini output sits from their own ground truth:
#
#   exact  identical after whitespace folding
#   near   >= 90% character accuracy
#   far    50-90%
#   poor   < 50%
#   empty  one side blank
#
# Weighted towards disagreement on purpose: rows where model and label already
# agree cost reviewer time and move no number. Weights need not sum to 1.
SAMPLE_TARGETS=exact=0.15,near=0.20,far=0.25,poor=0.25,empty=0.15

DATA_DIR=/data
